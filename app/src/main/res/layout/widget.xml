<?xml version="1.0" encoding="utf-8"?>
<!-- Black Ledger widget: header with the two tabs, then a scrolling list that fills whatever size it is given. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk"
            android:text="Directives"
            android:textColor="#F2F2F2"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/space_mono_regular"
            android:singleLine="true"
            android:textColor="#9A9A9A"
            android:textSize="10sp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tab_todo"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/space_grotesk"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="To do"
                android:textColor="#F2F2F2"
                android:textSize="13sp" />
            <ImageView
                android:id="@+id/line_todo"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="#F2F2F2"
                android:contentDescription="@null" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tab_shop"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/space_grotesk"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Shop"
                android:textColor="#9A9A9A"
                android:textSize="13sp" />
            <ImageView
                android:id="@+id/line_shop"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="#F2F2F2"
                android:contentDescription="@null"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

    <!-- Shopping progress: got (filled), not available (red), still to get (hollow). -->
    <ImageView
        android:id="@+id/strand"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <!-- Scrolls, so any widget size shows the whole list. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />
        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:fontFamily="@font/space_grotesk"
            android:gravity="center_vertical"
            android:textColor="#9A9A9A"
            android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>
